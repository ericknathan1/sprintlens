# ==============================================================================
# SprintLens - Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=sprintlens
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sprintlens?schema=public

# Optional Database Administration (pgAdmin)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@sprintlens.dev
PGADMIN_DEFAULT_PASSWORD=Admin@123

# Backend API Core (NestJS)
API_PORT=3001
JWT_SECRET=sprintlens-dev-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d
DATA_ENGINE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000

# Data Engine (Python FastAPI)
DATA_ENGINE_PORT=8000
DATA_ENGINE_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DATA_ENGINE_URL=http://localhost:8000
