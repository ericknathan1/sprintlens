    "@nestjs/swagger": "^7.2.0",
    "@prisma/client": "^5.9.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
